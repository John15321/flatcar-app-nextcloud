# Development Configuration
# Simple settings for local QEMU testing

# Database Configuration
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=development_password

# Nextcloud Admin Configuration
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=admin123

# Domain Configuration (for local development)
NEXTCLOUD_DOMAIN=localhost
NEXTCLOUD_TRUSTED_DOMAINS=localhost,127.0.0.1,10.0.2.15,192.168.1.100

# Development URLs
# Direct access: http://localhost:8080
# Via proxy: http://localhost or https://localhost
# Database admin: http://localhost:8081

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Development Notes:
# - Default passwords are simple for testing
# - Multiple trusted domains for QEMU networking
# - Self-signed SSL certificates will show browser warnings
# - All database ports exposed for debugging
