  "systemd": {
    "units": [
      {
        "enabled": true,
        "name": "docker.service"
      },
      {
        "contents": "[Unit]\nDescription=Download Docker Compose binary\nAfter=network-online.target\nWants=network-online.target\nConditionFirstBoot=true\nConditionPathExists=!/opt/bin/docker-compose\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=/bin/mkdir -p /opt/bin\nExecStart=/bin/bash -c 'curl -L --connect-timeout 30 --max-time 300 -o /opt/bin/docker-compose \"https://github.com/docker/compose/releases/download/v2.36.2/docker-compose-$(uname -s)-$(uname -m)\"'\nExecStart=/bin/chmod +x /opt/bin/docker-compose\nTimeoutStartSec=360\n\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "docker-compose-setup.service"
      },
      {
        "enabled": true,
        "name": "systemd-sysext.service"
      },
      {
        "contents": "[Unit]\nDescription=Setup Nextcloud Development Environment\nAfter=docker.service\nBefore=nextcloud-dev.service\nConditionFirstBoot=true\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=/bin/mkdir -p /opt/nextcloud/data /opt/nextcloud/config /opt/nextcloud/apps\nExecStart=/bin/mkdir -p /opt/nextcloud/db /opt/nextcloud/redis /opt/nextcloud/ssl\nExecStart=/opt/bin/generate-dev-ssl.sh\nExecStart=/bin/chown -R core:core /opt/nextcloud\n\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "setup-nextcloud-dev.service"
      },
      {
        "contents": "[Unit]\nDescription=Nextcloud Development Docker Compose Stack\nAfter=setup-nextcloud-dev.service docker-compose-setup.service\nRequires=docker.service setup-nextcloud-dev.service docker-compose-setup.service\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nWorkingDirectory=/opt/nextcloud\nUser=core\nGroup=core\nEnvironment=PATH=/opt/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin\n\n# Always pull latest images in development\nExecStartPre=/opt/bin/docker-compose pull\nExecStartPre=-/opt/bin/docker-compose down\nExecStart=/opt/bin/docker-compose up -d\nExecReload=/opt/bin/docker-compose restart\nExecStop=/opt/bin/docker-compose down\n\n# Auto-restart on failure\nRestart=on-failure\nRestartSec=10\nTimeoutStartSec=180\n\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "nextcloud-dev.service"
      },
      {
        "contents": "[Unit]\nDescription=Nextcloud Development Log Viewer\nAfter=nextcloud-dev.service\n\n[Service]\nType=simple\nUser=core\nGroup=core\nWorkingDirectory=/opt/nextcloud\nEnvironment=PATH=/opt/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin\nExecStart=/opt/bin/docker-compose logs -f\nRestart=always\nRestartSec=5\nStandardOutput=journal\nStandardError=journal\n\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "nextcloud-dev-logs.service"
      },
      {
        "contents": "[Unit]\nDescription=Show Nextcloud Development URLs\nAfter=nextcloud-dev.service\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nExecStart=/bin/bash -c 'sleep 30'\nExecStart=/bin/bash -c 'echo \"=== Nextcloud Development URLs ===\"'\nExecStart=/bin/bash -c 'echo \"Main Nextcloud: http://localhost:8080\"'\nExecStart=/bin/bash -c 'echo \"Via proxy: https://localhost (self-signed cert)\"'\nExecStart=/bin/bash -c 'echo \"Database admin: http://localhost:8081\"'\nExecStart=/bin/bash -c 'echo \"Default admin: admin / admin123\"'\nExecStart=/bin/bash -c 'echo \"==================================\"'\n\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "nextcloud-dev-info.service"
      }
    ]
  }
