# Development Configuration for Nextcloud with PostgreSQL
# Simple settings for local testing and development

# PostgreSQL Database Configuration
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=development_password

# Nextcloud Admin Configuration (simple for testing)
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=admin123

# Domain Configuration (for local development)
NEXTCLOUD_DOMAIN=localhost
NEXTCLOUD_TRUSTED_DOMAINS=localhost,127.0.0.1,10.0.2.15,192.168.1.100

# Redis Cache Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Collabora Online Configuration
COLLABORA_DOMAIN=localhost

# Development settings (more permissive)
PHP_MEMORY_LIMIT=512M
PHP_UPLOAD_LIMIT=16G

# Development Notes:
# - Simple passwords for easy testing
# - Includes Adminer for database management
# - Exposed ports for development tools
# - Multiple trusted domains for various networking scenarios
# - Self-signed SSL certificates will show browser warnings