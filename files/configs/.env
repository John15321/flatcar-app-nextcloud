# Simplified Development Configuration for Nextcloud
# Basic settings for local testing and development

# PostgreSQL Database Configuration
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=development_password

# Nextcloud Admin Configuration
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=admin123

# Domain Configuration (for local development)
NEXTCLOUD_TRUSTED_DOMAINS=localhost,127.0.0.1

# Development Notes:
# - Simple passwords for easy testing
# - Direct access via port 8080 (no reverse proxy)
# - Adminer available at port 8081 for database management
# - Collabora can be added separately if needed