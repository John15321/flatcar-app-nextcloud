[Unit]
Description=Show Nextcloud Development URLs
After=nextcloud-dev.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash -c 'sleep 30'
ExecStart=/bin/bash -c 'echo "=== Nextcloud Development URLs ==="'
ExecStart=/bin/bash -c 'echo "Main Nextcloud: http://localhost:8080"'
ExecStart=/bin/bash -c 'echo "Via proxy: https://localhost (self-signed cert)"'
ExecStart=/bin/bash -c 'echo "Database admin: http://localhost:8081"'
ExecStart=/bin/bash -c 'echo "Collabora Office: https://localhost:9980 (integrated with Nextcloud)"'
ExecStart=/bin/bash -c 'echo ""'
ExecStart=/bin/bash -c 'echo "Default admin: admin / admin123"'
ExecStart=/bin/bash -c 'echo ""'
ExecStart=/bin/bash -c 'echo "Pre-installed Apps:"'
ExecStart=/bin/bash -c 'echo "- Collaboration: Talk, Mail, Calendar, Office, Deck"'
ExecStart=/bin/bash -c 'echo "- Security: Passwords, Two-Factor Authentication, File Access Control"'
ExecStart=/bin/bash -c 'echo "- Workflow: Flow, Tables"'
ExecStart=/bin/bash -c 'echo "- Knowledge: Collectives, Notes, News"'
ExecStart=/bin/bash -c 'echo "- Media: Photos, Music, Unsplash"'
ExecStart=/bin/bash -c 'echo ""'
ExecStart=/bin/bash -c 'echo "Apps will be installed automatically after first boot."'
ExecStart=/bin/bash -c 'echo "This may take several minutes to complete."'
ExecStart=/bin/bash -c 'echo "=================================="'

[Install]
WantedBy=multi-user.target
