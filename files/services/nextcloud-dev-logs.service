[Unit]
Description=Nextcloud Development Log Viewer
After=nextcloud-dev.service

[Service]
Type=simple
User=core
Group=core
WorkingDirectory=/opt/nextcloud
Environment=PATH=/opt/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/opt/bin/docker-compose logs -f
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target