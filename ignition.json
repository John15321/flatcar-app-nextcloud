    ],
    "filesystems": [
      {
        "device": "/dev/disk/by-label/NEXTCLOUD_DATA",
        "format": "ext4",
        "label": "NEXTCLOUD_DATA",
        "path": "/var/lib/nextcloud",
        "wipeFilesystem": false
      }
    ]
  },
  "systemd": {
    "units": [
      {
        "contents": "[Unit]\nDescription=Mount Nextcloud Data Disk\nBefore=setup-nextcloud.service\n\n[Mount]\nWhat=/dev/disk/by-label/NEXTCLOUD_DATA\nWhere=/var/lib/nextcloud\nType=ext4\nOptions=defaults,noatime\n\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "var-lib-nextcloud.mount"
      },
      {
        "enabled": true,
        "name": "docker.service"
      },
      {
        "contents": "[Unit]\nDescription=Setup Nextcloud Environment\nAfter=docker.service var-lib-nextcloud.mount\nBefore=nextcloud.service\nConditionFirstBoot=true\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nUser=root\nExecStart=/usr/local/bin/setup-nextcloud-storage.sh\nExecStart=/usr/local/bin/setup-ssl.sh\nExecStart=/bin/mkdir -p /var/lib/nextcloud/data /var/lib/nextcloud/config /var/lib/nextcloud/apps\nExecStart=/bin/mkdir -p /var/lib/nextcloud/db /var/lib/nextcloud/redis /var/lib/nextcloud/backups\nExecStart=/bin/chown -R nextcloud:nextcloud /var/lib/nextcloud\nExecStart=/bin/chown -R nextcloud:nextcloud /opt/nextcloud\n\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "setup-nextcloud.service"
      },
      {
        "contents": "[Unit]\nDescription=Nextcloud Docker Compose Stack\nAfter=setup-nextcloud.service\nRequires=docker.service setup-nextcloud.service\nWants=network-online.target\nAfter=network-online.target\n\n[Service]\nType=oneshot\nRemainAfterExit=yes\nWorkingDirectory=/opt/nextcloud\nUser=nextcloud\nGroup=nextcloud\n\n# Pull latest images on start\nExecStartPre=/usr/bin/docker-compose pull\nExecStartPre=-/usr/bin/docker-compose down\nExecStart=/usr/bin/docker-compose up -d\nExecReload=/usr/bin/docker-compose restart\nExecStop=/usr/bin/docker-compose down\n\n# Restart policy\nRestart=on-failure\nRestartSec=30\nTimeoutStartSec=300\n\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "nextcloud.service"
      },
      {
        "contents": "[Unit]\nDescription=Nextcloud Backup\nAfter=nextcloud.service\nRequires=nextcloud.service\n\n[Service]\nType=oneshot\nUser=nextcloud\nGroup=nextcloud\nExecStart=/usr/local/bin/backup-nextcloud.sh\n",
        "name": "nextcloud-backup.service"
      },
      {
        "contents": "[Unit]\nDescription=Daily Nextcloud Backup\nRequires=nextcloud-backup.service\n\n[Timer]\nOnCalendar=daily\nPersistent=true\nRandomizedDelaySec=30m\n\n[Install]\nWantedBy=timers.target\n",
        "enabled": true,
        "name": "nextcloud-backup.timer"
      },
      {
        "contents": "[Unit]\nDescription=Nextcloud Health Check\nAfter=nextcloud.service\nRequires=nextcloud.service\n\n[Service]\nType=oneshot\nUser=nextcloud\nGroup=nextcloud\nExecStart=/usr/local/bin/health-check.sh\n",
        "name": "nextcloud-health.service"
      },
      {
        "contents": "[Unit]\nDescription=Nextcloud Health Check Timer\nRequires=nextcloud-health.service\n\n[Timer]\nOnBootSec=5min\nOnUnitActiveSec=10min\n\n[Install]\nWantedBy=timers.target\n",
        "enabled": true,
        "name": "nextcloud-health.timer"
      },
      {
        "enabled": true,
        "mask": false,
        "name": "flatcar-update.service"
      },
      {
        "enabled": true,
        "name": "nextcloud-firewall.service"
      },
      {
        "contents": "[Unit]\nDescription=Nextcloud Log Rotation\n\n[Service]\nType=oneshot\nExecStart=/usr/sbin/logrotate -f /etc/logrotate.d/nextcloud\n",
        "name": "logrotate-nextcloud.service"
      },
      {
        "contents": "[Unit]\nDescription=Daily Nextcloud Log Rotation\nRequires=logrotate-nextcloud.service\n\n[Timer]\nOnCalendar=daily\nPersistent=true\n\n[Install]\nWantedBy=timers.target\n",
        "enabled": true,
        "name": "logrotate-nextcloud.timer"
      }
    ]
  }
}
