{
  "ignition": {
    "version": "3.3.0"
  },
  "passwd": {
    "users": [
      {
        "groups": [
          "docker",
          "sudo"
        ],
        "homeDir": "/home/nextcloud",
        "name": "nextcloud",
        "sshAuthorizedKeys": [
          "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... your-ssh-key-here"
        ],
        "shell": "/bin/bash",
        "uid": 1000
      }
    ]
  },
  "storage": {
    "directories": [
      {
        "group": {
          "name": "nextcloud"
        },
        "path": "/opt/nextcloud",
        "user": {
          "name": "nextcloud"
        },
        "mode": 493
      },
      {
        "group": {
          "name": "nextcloud"
        },
        "path": "/var/lib/nextcloud",
        "user": {
          "name": "nextcloud"
        },
        "mode": 493
      },
      {
        "group": {
          "name": "nextcloud"
        },
        "path": "/etc/ssl/nextcloud",
        "user": {
          "name": "nextcloud"
        },
        "mode": 448
      },
      {
        "group": {
          "name": "nextcloud"
        },
        "path": "/var/log/nextcloud",
        "user": {
          "name": "nextcloud"
        },
        "mode": 493
      }
    ],
    "files": [
      {
        "group": {
          "name": "nextcloud"
        },
        "path": "/opt/nextcloud/.env",
        "user": {
          "name": "nextcloud"
        },
        "contents": {
          "compression": "gzip",
          "source": "data:;base64,"
        },
        "mode": 384
      },
      {
        "group": {
          "name": "nextcloud"
        },
        "path": "/opt/nextcloud/docker-compose.yml",
        "user": {
          "name": "nextcloud"
        },
        "contents": {
          "compression": "gzip",
          "source": "data:;base64,"
        },
        "mode": 420
      },
      {
        "group": {
          "name": "nextcloud"
        },
        "path": "/opt/nextcloud/nginx/nextcloud.conf",
        "user": {
          "name": "nextcloud"
        },
        "contents": {
          "compression": "gzip",
          "source": "data:;base64,"
        },
        "mode": 420
      },
      {
        "path": "/usr/local/bin/setup-nextcloud-storage.sh",
        "contents": {
          "compression": "gzip",
          "source": "data:;base64,"
        },
        "mode": 493
      },
      {
        "path": "/usr/local/bin/setup-ssl.sh",
        "contents": {
          "compression": "gzip",
          "source": "data:;base64,"
        },
        "mode": 493
      },
      {
        "path": "/usr/local/bin/backup-nextcloud.sh",
        "contents": {
          "compression": "gzip",
          "source": "data:;base64,"
        },
        "mode": 493
      },
      {
        "path": "/usr/local/bin/health-check.sh",
        "contents": {
          "compression": "gzip",
          "source": "data:;base64,"
        },
        "mode": 493
      },
      {
        "path": "/etc/logrotate.d/nextcloud",
        "contents": {
          "compression": "gzip",
          "source": "data:;base64,H4sIAAAAAAAC/1SNQQoCMQxF9z1F1i7sZtDzhE4swbQZkigO4t3FFhR374Xwfr6jZdGaOz2iiN7WfDiKVngmAIAVWfZBpoFBcB5StG1G7vOHBPe/S2N37lWvw7oGX6htMUPF6BM6LQt8N3+UXukdAAD//8qUjfKTAAAA"
        },
        "mode": 420
      },
      {
        "path": "/etc/sysctl.d/99-nextcloud.conf",
        "contents": {
          "compression": "gzip",
          "source": "data:;base64,H4sIAAAAAAAC/2zLSw7CIBSF4XlXQeKcFFugDtiCW2iQXg1RHrncPnT1pomRSafn/86JXWEj90rzxDLgPWGw0QFLmXzwH0s+xdIsgZfV5uwjlGJEuw+TR3qPuAsjZF1u1j0fmOY4/aJsIhB3CYFjgDAGuxmhtNZnoWpaD5PPS8/J5XF/mr69KDbobmjZsVr/SknZqaq+AQAA///Azv515wAAAA=="
        },
        "mode": 420
