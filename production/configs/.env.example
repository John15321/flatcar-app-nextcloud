# Nextcloud Production Environment
# Copy to .env and run: /opt/bin/generate-secrets.sh

# Domain and SSL
DOMAIN=nextcloud.yourdomain.com
ACME_EMAIL=admin@yourdomain.com

# Nextcloud admin
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=GENERATE_STRONG_PASSWORD

# Database
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=GENERATE_STRONG_PASSWORD

# Cache
REDIS_PASSWORD=GENERATE_STRONG_PASSWORD
# Collabora Office
COLLABORA_ADMIN_USER=admin
COLLABORA_ADMIN_PASSWORD=GENERATE_STRONG_PASSWORD

# Traefik Dashboard
TRAEFIK_AUTH=admin:GENERATE_BCRYPT_HASH

